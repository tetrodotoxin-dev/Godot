config_version=5

[application]
config/name="TTX image validation"
run/main_scene="res://images.tscn"

[editor_plugins]
enabled=PackedStringArray("res://addons/godot_ttx/providers/plugin.cfg")

[rendering]
renderer/rendering_method="gl_compatibility"

[ttx]
modules=["res://addons/godot_ttx/libcpu_provider.so"]
modules.web=["res://addons/godot_ttx/web/libcpu_provider.so"]
image_modules={"cpu":"res://addons/godot_ttx/libcpu_provider.so"}
image_modules.web={"cpu":"res://addons/godot_ttx/web/libcpu_provider.so"}
