config_version=5

[application]
config/name="TTX bridge validation"
run/main_scene="res://smoke.tscn"

[editor_plugins]
enabled=PackedStringArray("res://addons/godot_ttx/providers/plugin.cfg")

[rendering]
renderer/rendering_method="gl_compatibility"

[ttx]
modules=["res://addons/godot_ttx/libcounter_extension.so"]
modules.web=["res://addons/godot_ttx/web/libcounter_extension.so"]
