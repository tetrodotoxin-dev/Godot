[configuration]
entry_symbol = "godot_ttx_init"
compatibility_minimum = "4.7"
reloadable = false

[libraries]
linux.debug.x86_64 = "./libgodot_ttx.so"
linux.release.x86_64 = "./libgodot_ttx.so"
web.debug.wasm32 = "./web/libgodot_ttx.so"
web.release.wasm32 = "./web/libgodot_ttx.so"

[dependencies]
web.wasm32 = {"./web/libperimortem.so": "",
"./web/libttx.so": ""}
