[configuration]
entry_symbol = "godot_ttx_init"
compatibility_minimum = "4.7"
reloadable = false

[libraries]
linux.debug.x86_64 = "./libgodot_ttx.so"
linux.release.x86_64 = "./libgodot_ttx.so"
web.debug.wasm32 = "./libgodot_ttx.wasm"
web.release.wasm32 = "./libgodot_ttx.wasm"

[dependencies]
web.wasm32 = {"./libttx_runtime.wasm": ""}
