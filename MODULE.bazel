module(name = "godot")

bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "rules_pkg", version = "1.3.0")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "ttx_cuda", version = "0.2.0")
archive_override(
    module_name = "ttx_cuda",
    sha256 = "905f9a6ba597b88de9ea96932df5d87f0b0a9e8bbdf867995ee5a1c91a44e1cc",
    urls = ["https://github.com/tetrodotoxin-dev/CUDA/releases/download/v0.2.0/ttx_cuda-0.2.0-source.zip"],
)

nvidia = use_extension("@ttx_cuda//build:sdk.bzl", "dependencies")
use_repo(nvidia, "cuda_nvrtc_linux", "libcufft_linux")

godot_cpp_repository = use_repo_rule("//source/godot_ttx/build:sdk.bzl", "godot_cpp_repository")

godot_cpp_repository(
    name = "godot_cpp",
    build_file = "//source/godot_ttx/build:godot_cpp.BUILD.bazel",
    generator = "//source/godot_ttx/build:generate.py",
    profile = "//source/godot_ttx/build:profile.json",
)

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "pocketfft",
    build_file = "//source/demo/imaging/cpu:pocketfft.BUILD.bazel",
    sha256 = "2d90016da31a8cc1dd0ac0c89c1f2fb55df8f4ccc3f0386dcfbad09ac6d1c3ba",
    strip_prefix = "pocketfft-c90e55b3d529f8efa40ed01a20de22405f45fc65",
    type = "tar.gz",
    urls = ["https://codeload.github.com/mreineck/pocketfft/tar.gz/c90e55b3d529f8efa40ed01a20de22405f45fc65"],
)

godot_cpp_repository(
    name = "godot_cpp_web",
    bits = "32",
    build_file = "//source/godot_ttx/build:godot_cpp.BUILD.bazel",
    generator = "//source/godot_ttx/build:generate.py",
    profile = "//source/godot_ttx/build:profile.json",
)

bazel_dep(name = "tetro_toolchain", version = "0.2.1")
archive_override(
    module_name = "tetro_toolchain",
    sha256 = "eea7461fb783d2b87a638c4ce1c8d9cbee73e54c90259516ca73cd7e850bdc0f",
    urls = ["https://github.com/tetrodotoxin-dev/Toolchain/releases/download/v0.2.1/tetro_toolchain-0.2.1-source.tar.gz"],
)

register_toolchains("@tetro_toolchain//:cc_toolchain_for_linux_x86_64", "@tetro_toolchain//:cc_toolchain_for_wasm32", "@tetro_toolchain//:cc_toolchain_for_windows_x64")

sdks = use_extension("@tetro_toolchain//:sdk.bzl", "dependencies")
sdks.release(
    name = "perimortem",
    archives = {
        "headers": "2bb19a82ceb2dd06a122fb51142e96fd13d52fd5ed323b8a662cb640082636ed",
        "linux-x86_64-v3": "f62c3b71c9c5f554467c9dc03237073fc34d670fa596aa9cd99972dabfb2e653",
        "windows-x86_64-msvc": "543763f2a684bc410e264f60115a13cc92b20ae12ae25a9c5294c685f9d06d94",
        "wasm32-emscripten": "7c33f010c47932503f3ef8dcbddf3e4520a34b9e0bac70514a0cb38117400c42",
    },
    project = "Perimortem",
    version = "0.1.0",
    deps = [],
)
use_repo(sdks, "perimortem")

sdks.release(
    name = "ttx",
    archives = {
        "headers": "b29fc0774de7631a94042a9fc0f08e8a537366b380403d714133ee014bdaedfa",
        "linux-x86_64-v3": "0214ef3b44b52ec10c1c112d62feb4656771f0d8886303756ec47b847e3489cb",
        "windows-x86_64-msvc": "2058106e0a0458f6ed322b9288ad0ed6f3d57f550b64bc7c342e6bbc526a8346",
        "wasm32-emscripten": "997213f7564763ca5a496804d62b41b494515ae8a6adee91739b5bd64d7ee699",
    },
    project = "TTX",
    version = "0.2.0",
    deps = ["@perimortem"],
)
use_repo(sdks, "ttx")
