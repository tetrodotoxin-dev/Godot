load("@rules_cc//cc:cc_import.bzl", "cc_import")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

config_setting(
    name = "windows",
    constraint_values = ["@platforms//os:windows"],
)

cc_library(
    name = "headers",
    hdrs = glob(["include/**/*.h", "include/**/*.hpp"]),
    includes = ["include"],
)
cc_import(
    name = "perimortem",
    shared_library = select({":windows": "addons/godot_ttx/perimortem.dll", "//conditions:default": "addons/godot_ttx/libperimortem.so"}),
    interface_library = select({":windows": "addons/godot_ttx/perimortem.lib", "//conditions:default": None}),
    deps = [":headers"],
)
cc_import(
    name = "ttx",
    shared_library = select({":windows": "addons/godot_ttx/ttx.dll", "//conditions:default": "addons/godot_ttx/libttx.so"}),
    interface_library = select({":windows": "addons/godot_ttx/ttx.lib", "//conditions:default": None}),
    deps = [":perimortem"],
)
cc_import(
    name = "godot_ttx",
    shared_library = select({":windows": "addons/godot_ttx/godot_ttx.dll", "//conditions:default": "addons/godot_ttx/libgodot_ttx.so"}),
    interface_library = select({":windows": "addons/godot_ttx/godot_ttx.lib", "//conditions:default": None}),
    deps = [":ttx"],
)
