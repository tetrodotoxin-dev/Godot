[gd_scene load_steps=8 format=3]

[ext_resource type="Script" path="res://lab.gd" id="1"]
[ext_resource type="Theme" path="res://theme.tres" id="2"]
[ext_resource type="PackedScene" path="res://preview.tscn" id="3"]

[sub_resource type="TtxImage" id="Cpu"]
provider = "cpu"

[sub_resource type="TtxImage" id="Cuda"]
provider = "cuda"

[sub_resource type="TtxImage" id="Script"]
provider = "gdscript"

[sub_resource type="TtxImage" id="Overlay"]
provider = "gdscript"

[node name="Lab" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2")
script = ExtResource("1")
cpu_source = SubResource("Cpu")
cuda_source = SubResource("Cuda")
script_source = SubResource("Script")
overlay_source = SubResource("Overlay")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 30
theme_override_constants/margin_top = 26
theme_override_constants/margin_right = 30
theme_override_constants/margin_bottom = 26

[node name="Page" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 18

[node name="Heading" type="VBoxContainer" parent="Margin/Page"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Kicker" type="Label" parent="Margin/Page/Heading"]
layout_mode = 2
theme_override_colors/font_color = Color(0.51, 0.90, 0.76, 1)
theme_override_font_sizes/font_size = 13
text = "TETRODOTOXIN  /  COMPUTE LAB"

[node name="Title" type="Label" parent="Margin/Page/Heading"]
layout_mode = 2
theme_override_font_sizes/font_size = 34
text = "One image contract. Three providers."

[node name="Subtitle" type="Label" parent="Margin/Page/Heading"]
layout_mode = 2
theme_override_colors/font_color = Color(0.61, 0.68, 0.78, 1)
text = "GDScript, C++ and CUDA cooperate through TTX — the client stays the same."

[node name="Controls" type="HBoxContainer" parent="Margin/Page"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Mode" type="OptionButton" parent="Margin/Page/Controls"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Same inversion algorithm, or spatial versus FFT convolution"

[node name="Size" type="OptionButton" parent="Margin/Page/Controls"]
unique_name_in_owner = true
layout_mode = 2
