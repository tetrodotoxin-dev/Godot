[configuration]
entry_symbol = "godot_demo_init"
compatibility_minimum = "4.7"
reloadable = false

[libraries]
linux.debug.x86_64 = "./libgodot_demo.so"
linux.release.x86_64 = "./libgodot_demo.so"
web.debug.wasm32 = "./web/libgodot_demo.so"
web.release.wasm32 = "./web/libgodot_demo.so"

[dependencies]
web.wasm32 = {
"./web/libperimortem.so": "",
"./web/libttx.so": "",
"./web/liblab_support.so": "",
"./web/libcounter_extension.so": "",
"./web/libsampler_extension.so": "",
"./web/libcpu_provider.so": ""
}
