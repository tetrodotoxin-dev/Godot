load("@rules_cc//cc:cc_library.bzl", "cc_library")

cc_library(
    name = "godot_cpp",
    srcs = glob(["src/**/*.cpp", "gen/src/**/*.cpp"]),
    hdrs = glob(["include/**/*.hpp", "include/**/*.inc", "gen/include/**/*.hpp", "gdextension/*.h"]),
    includes = ["include", "gen/include", "gdextension"],
    defines = ["GDEXTENSION", "LINUX_ENABLED", "UNIX_ENABLED", "THREADS_ENABLED", "DEBUG_ENABLED"],
    # The upstream Wrapped lifecycle uses dynamic_cast during construction.
    copts = ["-std=c++17", "-frtti", "-Wno-unused-parameter", "-Wno-error=deprecated-declarations"],
    visibility = ["//visibility:public"],
)
